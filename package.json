{
  "name": "kabigting-apps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#server/*": "./src/server/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && node scripts/check-no-date-string.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:unit": "vitest run --project unit",
    "auth:generate": "auth generate --config scripts/auth-config.ts --output src/server/db/schema/auth.ts --yes && prettier --write src/server/db/schema/auth.ts --ignore-path=",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:int": "vitest run --project integration"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.{json,md,css,html,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@date-fns/tz": "1.5.0",
    "better-auth": "1.7.7",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  }
}
