{
  "name": "kabigting-apps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#server/*": "./src/server/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --env-file=.env --watch src/server/index.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && node scripts/check-no-date-string.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:unit": "vitest run --project unit",
    "auth:generate": "auth generate --config scripts/auth-config.ts --output src/server/db/schema/auth.ts --yes && prettier --write src/server/db/schema/auth.ts --ignore-path=",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:int": "vitest run --project integration",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.ts create",
    "admin:create-account": "node --env-file-if-exists=.env scripts/admin.ts create-account",
    "admin:reset": "node --env-file-if-exists=.env scripts/admin.ts reset",
    "admin:ban": "node --env-file-if-exists=.env scripts/admin.ts ban",
    "test:component": "vitest run --project component --project browser",
    "icons:generate": "pwa-assets-generator",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.46",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "auth": "1.7.7",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "vitest-browser-react": "2.3.0",
    "workbox-build": "7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.{json,md,css,html,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/db": "0.14.0",
    "@tanstack/query-db-collection": "1.4.4",
    "@tanstack/react-db": "0.5.9",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "lucide-react": "1.57.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.3",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  }
}
